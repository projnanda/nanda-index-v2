# index-v2-demo — every counterparty address is an environment override.
#
# The defaults in src/concierge/config.py point at the live hosted estate, so a
# clean checkout runs against real counterparties without any configuration.
# Set these to point the demo at your own.

# This agent's Ed25519 seed (32 bytes, base58 or hex). Generated per process
# when unset — set it to keep a stable did:key across restarts.
CONCIERGE_SEED=

# Where this copy's delegated grant lives. Unset uses the committed
# artifacts, which belong to the reference deployment: set this for any
# other copy and mint into it (see README, "Run it").
CONCIERGE_AUTHORITY=

# This agent's own public base URL, so the card it publishes resolves.
# Falls back to RAILWAY_PUBLIC_DOMAIN, then http://localhost:8080.
CONCIERGE_BASE_URL=

# The two indexes. PUBLIC_INDEX_URL is a NANDA Index v2 (capability search and
# org records); CONCIERGE_INDEX_URL is the second index, which binds a name to a
# key and does pointer resolution only.
PUBLIC_INDEX_URL=https://api.nandaindex.org
CONCIERGE_INDEX_URL=

# The three organisation servers whose catalogs are read.
REGENTIX_SERVER_URL=
ASTROCITY_SERVER_URL=
ROCKETBRAIN_SERVER_URL=

# The two guest agents. An outsider cannot discover a member's name from an
# org catalog, so these are configured and every receipt says so.
REGENTIX_CEO_URL=
REGENTIX_CAPABILITY=leadership
ASTROCITY_SCIENCE_URL=

# The restaurant.
VENUE_URL=

# The scenario's framing.
HOST_LABEL=the host
LUNCH_DATE=
LUNCH_STARTS=

# Limits for a public deployment. Each live run messages two companies' agents
# and holds a real table. RUN_LIMIT_PER_HOUR is per visitor (an IPv6 /64 counts
# as one) and unset means none; the global budget is shared by every visitor
# (default 20, 0 switches it off). Capability searches are limited per visitor
# per minute (default 20, 0 switches it off).
RUN_LIMIT_PER_HOUR=
RUN_LIMIT_GLOBAL_PER_HOUR=
CAPABILITY_LIMIT_PER_MINUTE=
