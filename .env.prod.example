# NANDA Index — production environment
# cp .env.prod.example .env.prod  — then fill in every blank value
# Generate strong secrets: openssl rand -hex 64

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
# Must be at least 32 chars in production
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Required in production — generate with: openssl rand -hex 64
COOKIE_SECRET=

# OAuth — create apps at:
#   Google: console.cloud.google.com  (Authorized redirect: https://api.nandaindex.org/auth/google/callback)
#   GitHub: github.com/settings/developers  (Callback: https://api.nandaindex.org/auth/github/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

OAUTH_CALLBACK_BASE_URL=https://api.nandaindex.org
# Resend API key — get one at resend.com (free tier: 3k emails/month). Required:
# the server refuses to start in production with SMTP_URL unset or "log".
SMTP_URL=re_YOUR_API_KEY
EMAIL_FROM=noreply@nandaindex.org
FRONTEND_URL=https://nandaindex.org
# Public API origin advertised by the ARD registry document (GET /api/ard)
API_BASE_URL=https://api.nandaindex.org
# Optional — OpenAI key for search enrichment (representative queries); skipped when empty
OPENAI_API_KEY=
OPENAI_ENRICHMENT_MODEL=gpt-4o-mini

# ── Web ───────────────────────────────────────────────────────────────────────
# Baked into the Next.js bundle at build time
NEXT_PUBLIC_NANDA_INDEX_API_URL=https://api.nandaindex.org

# Optional — Google Analytics (GA4), also baked in at build time
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional — PostHog (project API key, phc_…), baked in at build time. Enables
# consent-gated analytics + masked session replay on the web app (proxied via
# /ingest) and anonymous account/entry event counts from the API.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host: https://us.i.posthog.com (default), https://eu.i.posthog.com, or self-hosted
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Shared ────────────────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10
ORG_RECOVERY_RATE_LIMIT_MAX=30

# Concierge demo at https://nandaindex.org/demo (optional; defaults shown)
# DEMO_BASE_URL=https://nandaindex.org/demo
# DEMO_RUN_LIMIT_PER_HOUR=3
# DEMO_PUBLIC_INDEX_URL=https://api.nandaindex.org
