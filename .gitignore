# Environment — every env file holds secrets (.env.prod has all of production's).
# Only the committed *.example templates are tracked.
.env*
!.env.example
!.env.prod.example

# Dependencies
server/node_modules/
web/node_modules/

# Build output
server/dist/
web/.next/
web/tsconfig.tsbuildinfo

# Test coverage reports (vitest --coverage)
server/coverage/
web/coverage/

# Logs
*.log

# OS
.DS_Store

# Static files served directly by Caddy on the droplet (e.g. paper.pdf) —
# uploaded straight to the server, not tracked in git.
/static/*
!/static/.gitkeep

docs/

# Cloudflare Origin Certificate and private key: on the droplet only.
/certs/
