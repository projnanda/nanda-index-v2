# NANDA Index — environment variables
# Copy to .env and fill in values before running docker compose up

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=nanda-local

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=1d

# ── OAuth (optional — create apps at console.cloud.google.com / github.com/settings/developers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:3001

# ── Email (log = print verification link to console; no real email sent)
SMTP_URL=log
EMAIL_FROM=noreply@nanda.local
# Get involved form: primary recipient required for delivery; optional comma-separated CC list.
COMMUNITY_CONTACT_EMAIL=
COMMUNITY_CONTACT_CC=

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Public API URL used by the Next.js frontend at build time
NEXT_PUBLIC_NANDA_INDEX_API_URL=http://localhost:3001

# ── Misc ──────────────────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10
ORG_RECOVERY_RATE_LIMIT_MAX=30

# ── Signing (optional — only for signed IndexRecord responses)
SIGNING_KEY_ID=
SIGNING_PRIVATE_KEY=

# ── Outbound fetch safety ─────────────────────────────────────────────────────
# Agentic/ARD search fetches registrants' registry URLs server-side; private,
# loopback and link-local hosts are refused (SSRF guard). Set to true ONLY for
# local development against a registry on localhost — never in production.
#
# It also decides whether registry_url may be plaintext. With the default
# false, registering or changing a registry_url to http:// is refused and only
# https:// is accepted; turning it on allows http:// as well, because a
# registry on localhost is normally plaintext. A local docker compose setup
# therefore needs this on before it can register an http://localhost registry.
OUTBOUND_ALLOW_PRIVATE_HOSTS=false
